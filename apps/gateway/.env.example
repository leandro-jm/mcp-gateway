NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info
DATABASE_URL=postgres://gateway:gateway@localhost:15432/gateway
REDIS_URL=redis://localhost:16379
# openssl rand -base64 32
GATEWAY_MASTER_KEY=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtLS0tLS0tLS0=
# Validade da sessão da Admin UI (horas). Usuários e tokens ficam no Postgres (ADR-011).
AUTH_SESSION_TTL_HOURS=12
# Artefatos (opcional; sem S3, o offload fica desligado)
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=gateway
S3_SECRET_KEY=gateway-secret
S3_BUCKET=mcp-artifacts
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# METRICS_TOKEN=

# SSRF: dev usa upstreams locais; em produção mantenha false
NETWORK_ALLOW_PRIVATE=true
