# Gateway under test (Admin API + MCP)
BENCH_GATEWAY_URL=http://localhost:4000
# platform admin token (Admin UI > Tokens), short expiry, revoked after the run
BENCH_ADMIN_TOKEN=
# tenant slug and source name of the API being benchmarked
BENCH_TENANT=
BENCH_SOURCE_NAME=
# written by `pnpm env:setup` (token of the bench-agent service user)
BENCH_AGENT_TOKEN=

# Anthropic (dedicated key with a spend limit in the Console)
ANTHROPIC_API_KEY=
BENCH_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# hard caps in USD: total and per model (model:usd,...)
BENCH_MAX_USD=10
BENCH_MODEL_MAX_USD=claude-haiku-5-5:4,claude-sonnet-5-5:6

# decision provider for scenarios C and D (ADR-025)
JEV_API_KEY=
# API root without the endpoint (the gateway appends /systemone); empty = https://api.typesafe.ai/v1
JEV_BASE_URL=
# empty = provider default
JEV_MODEL=
