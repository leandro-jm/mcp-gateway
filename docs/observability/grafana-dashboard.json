{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "MCP Gateway",
  "uid": "mcp-gateway",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "mcp",
    "gateway"
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(mcp_tool_calls_total, tenant)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Chamadas/s",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total{tenant=~\"$tenant\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Taxa de erro",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total{tenant=~\"$tenant\",decision=\"error\"}[5m])) / clamp_min(sum(rate(mcp_tool_calls_total{tenant=~\"$tenant\"}[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Negações de autorização/s",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_tool_calls_total{tenant=~\"$tenant\",decision=\"deny\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bytes poupados (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mcp_projection_bytes_saved_total{tenant=~\"$tenant\"}[1h])) + sum(increase(mcp_artifact_offloaded_bytes_total{tenant=~\"$tenant\"}[1h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latência por tool — p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tool) (rate(mcp_tool_call_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "p50 {{tool}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_tool_call_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "p95 {{tool}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, tool) (rate(mcp_tool_call_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "p99 {{tool}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Taxa de erro por source (upstream)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(mcp_upstream_requests_total{tenant=~\"$tenant\",status_class=~\"5xx|error\"}[5m])) / clamp_min(sum by (source) (rate(mcp_upstream_requests_total{tenant=~\"$tenant\"}[5m])), 1e-9)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latência do upstream p95 por source",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(mcp_upstream_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bytes economizados por projeção e artefatos",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(mcp_projection_bytes_saved_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "projeção {{tool}}"
        },
        {
          "refId": "B",
          "expr": "sum by (tool) (rate(mcp_artifact_offloaded_bytes_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "artefato {{tool}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redactions por detector",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detector) (rate(mcp_redactions_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{detector}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Chamadas por decisão",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(mcp_tool_calls_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Overhead do gateway × upstream (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_gateway_overhead_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "overhead p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_upstream_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "upstream p95"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Latência por etapa (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(mcp_call_stage_duration_seconds_bucket{tenant=~\"$tenant\"}[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Erros por etapa",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(mcp_call_errors_total{tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Tokens economizados por mecanismo",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mechanism) (increase(mcp_tokens_saved_total{tenant=~\"$tenant\"}[1h]))",
          "legendFormat": "{{mechanism}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Circuit breakers abertos",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (source) (mcp_circuit_open{tenant=~\"$tenant\"})",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Eventos de analytics (escritos × descartados)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mcp_call_events_written_total[5m]))",
          "legendFormat": "escritos/s"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(mcp_call_events_dropped_total[5m]))",
          "legendFormat": "descartados {{reason}}"
        }
      ]
    }
  ]
}
