# Copy to .env (or register them as stack variables in Portainer)
# Image version: pin a release (e.g. 0.1.0) instead of latest, so a redeploy never changes it silently
TAG=0.1.0
# Public images on Docker Hub (leandrojm/mcp-gateway, -crawler, -admin-ui); ghcr.io/leandro-jm for GHCR
IMAGE_NAMESPACE=leandrojm
PUBLIC_URL=https://mcp.example.com
POSTGRES_PASSWORD=troque-isto
# openssl rand -base64 32  (NEVER change it afterwards: it decrypts the credentials)
GATEWAY_MASTER_KEY=
S3_ACCESS_KEY=gateway
S3_SECRET_KEY=troque-isto-tambem
# First-run setup (ADR-024): the Admin UI asks for this secret to create the first admin and tenant.
# openssl rand -hex 16 (at least 16 characters). Empty = setup disabled (use create-admin). Remove it after the setup.
SETUP_TOKEN=
# Admin UI session lifetime (hours). Users and tokens live in Postgres (ADR-011).
AUTH_SESSION_TTL_HOURS=12
# Bearer required by /metrics: openssl rand -hex 32
METRICS_TOKEN=
# Proxies trusted for X-Forwarded-For: false, a hop count or IPs/CIDRs (never true when port 4000 is exposed)
TRUST_PROXY=false
NETWORK_ALLOW_PRIVATE=false
# Agent observability (F15): retention of raw call events (days), rollups (days) and the LGPD subject index (months)
CALL_EVENTS_RETENTION_DAYS=30
CALL_ROLLUPS_RETENTION_DAYS=400
SUBJECT_INDEX_RETENTION_MONTHS=12
# Opt-in debug capture of raw payloads (encrypted, 24 h). Keep false unless you need it (ADR-017)
DEBUG_CAPTURE_ENABLED=false
# Link from the call explorer to your trace UI, e.g. https://jaeger.example.com/trace/{traceId}
TRACE_UI_URL_TEMPLATE=
GATEWAY_PORT=4000
ADMIN_UI_PORT=8080
